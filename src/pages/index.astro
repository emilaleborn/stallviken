---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Hem" activeNav="home">
    <section class="hero">
        <div class="carousel">
            <div class="carousel-container">
                <div class="carousel-slide active">
                    <img src="/images/IMG_3399.jpeg" alt="Stallvikens Islandshästar">
                    <div class="carousel-caption">
                        <h2>Välkommen till Stallvikens Islandshästar</h2>
                        <p>Din partner för islandshästutbildning och träning</p>
                    </div>
                </div>
                <div class="carousel-slide">
                    <img src="/images/IMG_3400.jpeg" alt="Hästträning">
                    <div class="carousel-caption">
                        <h2>Professionell träning</h2>
                        <p>Från nybörjare till avancerad nivå</p>
                    </div>
                </div>
                <div class="carousel-slide">
                    <img src="/images/IMG_3401.jpeg" alt="Hästar till salu">
                    <div class="carousel-caption">
                        <h2>Kvalitetshästar till salu</h2>
                        <p>Hitta din perfekta islandshäst</p>
                    </div>
                </div>
            </div>
            <button class="carousel-prev" aria-label="Previous slide">❮</button>
            <button class="carousel-next" aria-label="Next slide">❯</button>
            <div class="carousel-indicators">
                <span class="indicator active" data-slide="0"></span>
                <span class="indicator" data-slide="1"></span>
                <span class="indicator" data-slide="2"></span>
            </div>
        </div>
    </section>

    <section class="intro">
        <div class="container">
            <h2>Välkommen till Stallvikens Islandshästar</h2>
            <p class="lead">Vi är specialiserade på utbildning och träning av islandshästar. Hos oss hittar du allt från ridlektioner för nybörjare till avancerad gångartsträning, samt noggrant utvalda islandshästar till salu.</p>
        </div>
    </section>

    <section class="quick-links">
        <div class="container">
            <h2>Snabblänkar</h2>
            <div class="cards">
                <div class="card">
                    <h3>Aktuella kurser</h3>
                    <p>Tölthelg 15-16 juni</p>
                    <p>Nybörjarkurs 22 juni</p>
                    <a href="/utbildning" class="btn">Se alla kurser</a>
                </div>
                <div class="card">
                    <h3>Våra hästar</h3>
                    <p>Lär känna våra underbara islandshästar</p>
                    <a href="/till-salu" class="btn">Möt hästarna</a>
                </div>
                <div class="card">
                    <h3>Kontakta oss</h3>
                    <p>Har du frågor eller vill boka en tid?</p>
                    <a href="/kontakt" class="btn">Kontakt</a>
                </div>
            </div>
        </div>
    </section>

    <section class="services-overview">
        <div class="container">
            <h2>Vad vi erbjuder</h2>
            <div class="services-grid">
                <div class="service-item">
                    <h3>Ridlektioner</h3>
                    <p>Privatlektioner och grupplektioner för alla nivåer</p>
                </div>
                <div class="service-item">
                    <h3>Hästträning</h3>
                    <p>Inridning och vidareutbildning av din häst</p>
                </div>
                <div class="service-item">
                    <h3>Kurser</h3>
                    <p>Helgkurser och temadagar inom olika områden</p>
                </div>
                <div class="service-item">
                    <h3>Töltträning</h3>
                    <p>Specialiserad träning för islandshästens unika gångarter</p>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>