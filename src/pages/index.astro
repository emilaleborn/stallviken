---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Hem" activeNav="home">
    <section class="hero">
        <div class="carousel">
            <div class="carousel-container">
                <div class="carousel-slide active">
                    <img src="/images/IMG_3399.jpeg" alt="Stallvikens Islandshästar">
                    <div class="carousel-caption">
                        <h2>Välkommen till Stallvikens Islandshästar</h2>
                        <p></p>
                    </div>
                </div>
                <div class="carousel-slide">
                    <img src="/images/IMG_3400.jpeg" alt="Hästträning">
                    <div class="carousel-caption">
                        <h2>Småskalig träning</h2>
                        <p></p>
                    </div>
                </div>
                <div class="carousel-slide">
                    <img src="/images/IMG_3401.jpeg" alt="Hästar till salu">
                    <div class="carousel-caption">
                        <h2>Våra Hästar</h2>
                        <p>Våra Hästar</p>
                    </div>
                </div>
            </div>
            <button class="carousel-prev" aria-label="Previous slide">❮</button>
            <button class="carousel-next" aria-label="Next slide">❯</button>
            <div class="carousel-indicators">
                <span class="indicator active" data-slide="0"></span>
                <span class="indicator" data-slide="1"></span>
                <span class="indicator" data-slide="2"></span>
            </div>
        </div>
    </section>

    <section class="intro">
        <div class="container">
            <h2>Välkommen till Stallvikens Islandshästar</h2>
            <p class="lead"></p>
        </div>
    </section>

    <section class="quick-links">
        <div class="container">
            <h2>Snabblänkar</h2>
            <div class="cards">
                <div class="card">
                    <h3>Våra hästar</h3>
                    <p>Lär känna våra underbara islandshästar</p>
                    <a href="/till-salu" class="btn">Möt hästarna</a>
                </div>
                <div class="card">
                    <h3>Kontakta oss</h3>
                    <p></p>
                    <a href="/kontakt" class="btn">Kontakt</a>
                </div>
            </div>
        </div>
    </section>

    <section class="services-overview">
        <div class="container">
            <h2>Vad vi erbjuder</h2>
            <div class="services-grid">
                <div class="service-item">
                    <h3>Ridlektioner</h3>
                    <p>Privatlektioner för barn mellan 6 - 13år</p>
                </div>
                <div class="service-item">
                    <h3>Hästträning</h3>
                    <p>Inridning och vidareutbildning av din häst</p>
                </div>
                <div class="service-item">
                    <h3></h3>
                    <p></p>
                </div>
                <div class="service-item">
                    <h3></h3>
                    <p></p>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>