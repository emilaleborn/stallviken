---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Våra hästar - Stallvikens Islandshästar" activeNav="till-salu">
  <style>
    .page-header {
      background: linear-gradient(rgba(139, 69, 19, 0.7), rgba(139, 69, 19, 0.7)), url('/images/IMG_3400.jpeg');
      background-size: cover;
      background-position: center;
      color: white;
      padding: 100px 0;
      text-align: center;
    }
    
    .page-header h1 {
      font-size: 3rem;
      margin-bottom: 20px;
    }
    
    .horses-for-sale {
      display: grid;
      gap: 40px;
      margin-top: 40px;
    }
    
    .horse-listing {
      background-color: var(--white);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 30px;
    }
    
    .horse-images {
      position: relative;
    }
    
    .main-image {
      width: 100%;
      height: 400px;
      object-fit: cover;
      cursor: pointer;
    }
    
    .thumbnail-gallery {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      padding: 10px;
      background-color: var(--light-bg);
    }
    
    .thumbnail {
      width: 100%;
      height: 80px;
      object-fit: cover;
      cursor: pointer;
      opacity: 0.7;
      transition: opacity 0.3s ease;
    }
    
    .thumbnail:hover,
    .thumbnail.active {
      opacity: 1;
    }
    
    .horse-details {
      padding: 30px;
    }
    
    .horse-details h2 {
      color: var(--primary-color);
      font-size: 2rem;
      margin-bottom: 20px;
    }
    
    .horse-specs {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      margin-bottom: 30px;
      padding: 20px;
      background-color: var(--light-bg);
      border-radius: 5px;
    }
    
    .spec-item {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .spec-item strong {
      color: var(--primary-color);
      min-width: 100px;
    }
    
    .horse-description {
      margin-bottom: 20px;
      line-height: 1.8;
    }
    
    .price-tag {
      font-size: 1.5rem;
      color: var(--primary-color);
      font-weight: bold;
      margin-bottom: 20px;
    }
    
    .contact-seller {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }
    
    .contact-seller a {
      padding: 12px 25px;
      background-color: var(--primary-color);
      color: white;
      text-decoration: none;
      border-radius: 5px;
      transition: background-color 0.3s ease;
    }
    
    .contact-seller a:hover {
      background-color: var(--secondary-color);
    }
    
    .sold-horses {
      margin-top: 60px;
      padding: 40px;
      background-color: var(--light-bg);
      border-radius: 10px;
    }
    
    .sold-horses h2 {
      color: var(--primary-color);
      margin-bottom: 30px;
      text-align: center;
    }
    
    .sold-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
    }
    
    .sold-horse {
      text-align: center;
    }
    
    .sold-horse img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 5px;
      filter: grayscale(50%);
    }
    
    .sold-horse p {
      margin-top: 10px;
      font-weight: 600;
    }
    
    .stable-info {
      background-color: var(--light-bg);
      padding: 40px;
      border-radius: 10px;
      margin-top: 40px;
      text-align: center;
    }
    
    .stable-info h3 {
      color: var(--primary-color);
      margin-bottom: 20px;
      font-size: 2rem;
    }
    
    .stable-info p {
      max-width: 800px;
      margin: 0 auto 20px;
      line-height: 1.8;
      color: var(--text-color);
    }
    
    .video-container {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      margin-top: 20px;
    }
    
    .video-container iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
    
    .lightbox {
      display: none;
      position: fixed;
      z-index: 9999;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.9);
    }
    
    .lightbox-content {
      position: relative;
      max-width: 90%;
      max-height: 90%;
      margin: auto;
      top: 50%;
      transform: translateY(-50%);
      text-align: center;
    }
    
    .lightbox-content img {
      max-width: 100%;
      max-height: 90vh;
    }
    
    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 40px;
      color: white;
      font-size: 40px;
      cursor: pointer;
    }
    
    .lightbox-caption {
      color: white;
      margin-top: 20px;
      font-size: 1.1rem;
    }
    
    @media (max-width: 768px) {
      .page-header h1 {
        font-size: 2rem;
      }
      
      .horse-listing {
        grid-template-columns: 1fr;
      }
      
      .horse-specs {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <main>
    <section class="page-header">
      <div class="container">
        <h1>Våra hästar</h1>
        <p>Möt våra fantastiska islandshästar på Stallvikens Islandshästar</p>
      </div>
    </section>

    <section class="container">
      <div class="horses-for-sale">
        <div class="horse-listing">
          <div class="horse-images">
            <img src="/images/IMG_3399.jpeg" alt="Órion från Tavelsjö" class="main-image lightbox-trigger" id="main-image-1" data-fullsize="/images/IMG_3399.jpeg">
            <div class="thumbnail-gallery">
              <img src="/images/IMG_3399.jpeg" alt="Órion bild 1" class="thumbnail active" onclick="changeMainImage(1, 1)">
              <img src="/images/IMG_3400.jpeg" alt="Órion bild 2" class="thumbnail" onclick="changeMainImage(1, 2)">
              <img src="/images/IMG_3401.jpeg" alt="Órion bild 3" class="thumbnail" onclick="changeMainImage(1, 3)">
            </div>
          </div>
          <div class="horse-details">
            <h2>Órion från Tavelsjö</h2>
            <div class="horse-specs">
              <div class="spec-item">
                <strong>Född:</strong>
                <span>2016</span>
              </div>
              <div class="spec-item">
                <strong>Kön:</strong>
                <span>Valack</span>
              </div>
              <div class="spec-item">
                <strong>Färg:</strong>
                <span>Fux</span>
              </div>
              <div class="spec-item">
                <strong>Mankhöjd:</strong>
                <span>140 cm</span>
              </div>
              <div class="spec-item">
                <strong>Gångarter:</strong>
                <span>Femgångare</span>
              </div>
              <div class="spec-item">
                <strong>Utbildning:</strong>
                <span>Avancerad ridhäst</span>
              </div>
            </div>
            <div class="horse-description">
              <p>Órion är en stabil och trygg valack med utmärkta gångarter. Hans mjuka tölt och rytmiska pass gör honom till en favorit bland våra elever. Han är en perfekt lärare för den som vill utveckla sin gångartsridning.</p>
              <p>Med sitt lugna temperament och sin förmåga att anpassa sig efter ryttarens nivå är Órion idealisk för både nybörjare och erfarna ryttare. Han älskar terrängridning och är alltid pålitlig.</p>
            </div>
          </div>
        </div>

        <div class="horse-listing">
          <div class="horse-images">
            <img src="/images/IMG_3402.jpeg" alt="Díva från Bräckeskog" class="main-image lightbox-trigger" id="main-image-2" data-fullsize="/images/IMG_3402.jpeg">
            <div class="thumbnail-gallery">
              <img src="/images/IMG_3402.jpeg" alt="Díva bild 1" class="thumbnail active" onclick="changeMainImage(2, 1)">
              <img src="/images/IMG_3403.jpeg" alt="Díva bild 2" class="thumbnail" onclick="changeMainImage(2, 2)">
              <img src="/images/IMG_3404.jpeg" alt="Díva bild 3" class="thumbnail" onclick="changeMainImage(2, 3)">
            </div>
          </div>
          <div class="horse-details">
            <h2>Díva från Bräckeskog</h2>
            <div class="horse-specs">
              <div class="spec-item">
                <strong>Född:</strong>
                <span>2014</span>
              </div>
              <div class="spec-item">
                <strong>Kön:</strong>
                <span>Sto</span>
              </div>
              <div class="spec-item">
                <strong>Färg:</strong>
                <span>Svart</span>
              </div>
              <div class="spec-item">
                <strong>Mankhöjd:</strong>
                <span>137 cm</span>
              </div>
              <div class="spec-item">
                <strong>Gångarter:</strong>
                <span>Fyrgångare</span>
              </div>
              <div class="spec-item">
                <strong>Utbildning:</strong>
                <span>Tävlingshäst</span>
              </div>
            </div>
            <div class="horse-description">
              <p>Díva lever verkligen upp till sitt namn med sin eleganta framtoning och stolta hållning. Hon är en erfaren tävlingshäst med många framgångar inom tölt och fyrgång. Hennes precision och vilja att prestera gör henne till en utmärkt partner för ambitiösa ryttare.</p>
              <p>Trots sin tävlingsbakgrund är Díva mycket tillgiven och samarbetsvillig. Hon har en underbar personlighet och är alltid ivrig att göra sitt bästa för sin ryttare.</p>
            </div>
          </div>
        </div>

        <div class="horse-listing">
          <div class="horse-images">
            <img src="/images/IMG_3405.jpeg" alt="Lilja från Stallviken" class="main-image lightbox-trigger" id="main-image-3" data-fullsize="/images/IMG_3405.jpeg">
            <div class="thumbnail-gallery">
              <img src="/images/IMG_3405.jpeg" alt="Lilja bild 1" class="thumbnail active" onclick="changeMainImage(3, 1)">
              <img src="/images/IMG_3406.jpeg" alt="Lilja bild 2" class="thumbnail" onclick="changeMainImage(3, 2)">
              <img src="/images/IMG_3407.jpeg" alt="Lilja bild 3" class="thumbnail" onclick="changeMainImage(3, 3)">
            </div>
          </div>
          <div class="horse-details">
            <h2>Lilja från Stallviken</h2>
            <div class="horse-specs">
              <div class="spec-item">
                <strong>Född:</strong>
                <span>2019</span>
              </div>
              <div class="spec-item">
                <strong>Kön:</strong>
                <span>Sto</span>
              </div>
              <div class="spec-item">
                <strong>Färg:</strong>
                <span>Isabell</span>
              </div>
              <div class="spec-item">
                <strong>Mankhöjd:</strong>
                <span>135 cm</span>
              </div>
              <div class="spec-item">
                <strong>Gångarter:</strong>
                <span>Fyrgångare</span>
              </div>
              <div class="spec-item">
                <strong>Utbildning:</strong>
                <span>Grundutbildad</span>
              </div>
            </div>
            <div class="horse-description">
              <p>Lilja är vårt unga stjärnskott med en ljuvlig personlighet. Hon är nyfiken, läraktig och har visat fantastiska anlag för tölt redan i ung ålder. Hennes mjuka gångarter och villiga sinne gör henne till en dröm att arbeta med.</p>
              <p>Som ung häst har Lilja mycket att lära, men hennes positiva inställning och snabba inlärningsförmåga lovar gott för framtiden. Hon är perfekt för barn och ungdomar som vill växa tillsammans med sin häst.</p>
            </div>
          </div>
        </div>

        <div class="horse-listing">
          <div class="horse-images">
            <img src="/images/IMG_3408.jpeg" alt="Prins från Skälleryd" class="main-image lightbox-trigger" id="main-image-4" data-fullsize="/images/IMG_3408.jpeg">
            <div class="thumbnail-gallery">
              <img src="/images/IMG_3408.jpeg" alt="Prins bild 1" class="thumbnail active" onclick="changeMainImage(4, 1)">
              <img src="/images/IMG_3409.jpeg" alt="Prins bild 2" class="thumbnail" onclick="changeMainImage(4, 2)">
              <img src="/images/IMG_3410.jpeg" alt="Prins bild 3" class="thumbnail" onclick="changeMainImage(4, 3)">
            </div>
          </div>
          <div class="horse-details">
            <h2>Prins från Skälleryd</h2>
            <div class="horse-specs">
              <div class="spec-item">
                <strong>Född:</strong>
                <span>2013</span>
              </div>
              <div class="spec-item">
                <strong>Kön:</strong>
                <span>Hingst</span>
              </div>
              <div class="spec-item">
                <strong>Färg:</strong>
                <span>Brun</span>
              </div>
              <div class="spec-item">
                <strong>Mankhöjd:</strong>
                <span>143 cm</span>
              </div>
              <div class="spec-item">
                <strong>Gångarter:</strong>
                <span>Femgångare</span>
              </div>
              <div class="spec-item">
                <strong>Utbildning:</strong>
                <span>Avelhingst & ridhäst</span>
              </div>
            </div>
            <div class="horse-description">
              <p>Prins är en imponerande hingst med utmärkt exteriör och fantastiska gångarter. Han har en stark personlighet kombinerad med ett vänligt och tillgivet temperament. Som avelhingst har han producerat många framgångsrika avkommor.</p>
              <p>Under sadel är Prins kraftfull men samtidigt lyhörd och samarbetsvillig. Hans spektakulära pass och flytande tölt gör honom till en upplevelse att rida för erfarna ryttare.</p>
            </div>
          </div>
        </div>

        <div class="horse-listing">
          <div class="horse-images">
            <img src="/images/IMG_3401.jpeg" alt="Lúsífer från Lysegården" class="main-image lightbox-trigger" id="main-image-5" data-fullsize="/images/IMG_3401.jpeg">
            <div class="thumbnail-gallery">
              <img src="/images/IMG_3401.jpeg" alt="Lúsífer bild 1" class="thumbnail active" onclick="changeMainImage(5, 1)">
              <img src="/images/IMG_3402.jpeg" alt="Lúsífer bild 2" class="thumbnail" onclick="changeMainImage(5, 2)">
              <img src="/images/IMG_3403.jpeg" alt="Lúsífer bild 3" class="thumbnail" onclick="changeMainImage(5, 3)">
            </div>
          </div>
          <div class="horse-details">
            <h2>Lúsífer från Lysegården</h2>
            <div class="horse-specs">
              <div class="spec-item">
                <strong>Född:</strong>
                <span>2011</span>
              </div>
              <div class="spec-item">
                <strong>Kön:</strong>
                <span>Valack</span>
              </div>
              <div class="spec-item">
                <strong>Färg:</strong>
                <span>Mörkfux</span>
              </div>
              <div class="spec-item">
                <strong>Mankhöjd:</strong>
                <span>141 cm</span>
              </div>
              <div class="spec-item">
                <strong>Gångarter:</strong>
                <span>Femgångare</span>
              </div>
              <div class="spec-item">
                <strong>Utbildning:</strong>
                <span>Erfaren lektionshäst</span>
              </div>
            </div>
            <div class="horse-description">
              <p>Lúsífer är vår erfarna lärare med många års erfarenhet av att ta hand om ryttare i alla åldrar. Hans tålamod och lugn är legendariskt, och han har lärt otaliga ryttare konsten att tölt. Trots sitt dramatiska namn är han den snällaste hästen du kan tänka dig.</p>
              <p>Med sin stabila personlighet och pålitliga natur är Lúsífer ovärderlig i vår verksamhet. Han anpassar sig perfekt efter ryttarens förmåga och ger alltid en trygg och lärorik upplevelse.</p>
            </div>
          </div>
        </div>

        <div class="horse-listing">
          <div class="horse-images">
            <img src="/images/IMG_3404.jpeg" alt="Efa frá Syðra-Skörðugili" class="main-image lightbox-trigger" id="main-image-6" data-fullsize="/images/IMG_3404.jpeg">
            <div class="thumbnail-gallery">
              <img src="/images/IMG_3404.jpeg" alt="Efa bild 1" class="thumbnail active" onclick="changeMainImage(6, 1)">
              <img src="/images/IMG_3405.jpeg" alt="Efa bild 2" class="thumbnail" onclick="changeMainImage(6, 2)">
              <img src="/images/IMG_3406.jpeg" alt="Efa bild 3" class="thumbnail" onclick="changeMainImage(6, 3)">
            </div>
          </div>
          <div class="horse-details">
            <h2>Efa frá Syðra-Skörðugili</h2>
            <div class="horse-specs">
              <div class="spec-item">
                <strong>Född:</strong>
                <span>2017</span>
              </div>
              <div class="spec-item">
                <strong>Kön:</strong>
                <span>Sto</span>
              </div>
              <div class="spec-item">
                <strong>Färg:</strong>
                <span>Skimmel</span>
              </div>
              <div class="spec-item">
                <strong>Mankhöjd:</strong>
                <span>138 cm</span>
              </div>
              <div class="spec-item">
                <strong>Gångarter:</strong>
                <span>Fyrgångare</span>
              </div>
              <div class="spec-item">
                <strong>Utbildning:</strong>
                <span>Importerad från Island</span>
              </div>
            </div>
            <div class="horse-description">
              <p>Efa är vår senaste import direkt från Island, med äkta isländsk anda och temperament. Hon har den typiska isländska hästens mod och självförtroende, kombinerat med en vänlig och nyfiken personlighet. Hennes tölt är exceptionellt bekväm och rytmisk.</p>
              <p>Som relativt nyimporterad är Efa fortfarande under utbildning i svensk ridkultur, men hon visar redan prov på att bli en fantastisk allroundhäst. Hennes starka band till naturen gör henne perfekt för långa turer i skog och mark.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="stable-info">
        <h3>Om våra hästar</h3>
        <p>Våra hästar är en viktig del av verksamheten på Stallvikens Islandshästar. Varje häst har sin egen personlighet och historia, och vi är stolta över att kunna erbjuda våra elever möjligheten att rida på dessa fantastiska djur.</p>
        <p>Alla våra hästar får regelbunden träning, veterinärvård och hovvård för att säkerställa deras välbefinnande. Vi lägger stor vikt vid att matcha rätt häst med rätt ryttare för att skapa en trygg och givande upplevelse för alla.</p>
      </div>
    </section>
  </main>

  <script>
    function changeMainImage(horseId, imageNum) {
      const mainImage = document.getElementById('main-image-' + horseId);
      const thumbnails = mainImage.parentElement.querySelectorAll('.thumbnail');
      
      // Update main image
      const horseImages = {
        1: ['/images/IMG_3399.jpeg', '/images/IMG_3400.jpeg', '/images/IMG_3401.jpeg'],
        2: ['/images/IMG_3402.jpeg', '/images/IMG_3403.jpeg', '/images/IMG_3404.jpeg'],
        3: ['/images/IMG_3405.jpeg', '/images/IMG_3406.jpeg', '/images/IMG_3407.jpeg'],
        4: ['/images/IMG_3408.jpeg', '/images/IMG_3409.jpeg', '/images/IMG_3410.jpeg'],
        5: ['/images/IMG_3401.jpeg', '/images/IMG_3402.jpeg', '/images/IMG_3403.jpeg'],
        6: ['/images/IMG_3404.jpeg', '/images/IMG_3405.jpeg', '/images/IMG_3406.jpeg']
      };
      mainImage.src = horseImages[horseId][imageNum-1];
      mainImage.dataset.fullsize = horseImages[horseId][imageNum-1];
      
      // Update active thumbnail
      thumbnails.forEach((thumb, index) => {
        if (index === imageNum - 1) {
          thumb.classList.add('active');
        } else {
          thumb.classList.remove('active');
        }
      });
    }
    
    // Initialize lightbox functionality
    document.addEventListener('DOMContentLoaded', function() {
      initLightbox();
    });
  </script>
</BaseLayout>