---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Hästar till salu - Stallvikens Islandshästar" activeNav="till-salu">
  <style>
    .page-header {
      background: linear-gradient(rgba(139, 69, 19, 0.7), rgba(139, 69, 19, 0.7)), url('/images/IMG_3400.jpeg');
      background-size: cover;
      background-position: center;
      color: white;
      padding: 100px 0;
      text-align: center;
    }
    
    .page-header h1 {
      font-size: 3rem;
      margin-bottom: 20px;
    }
    
    .horses-for-sale {
      display: grid;
      gap: 40px;
      margin-top: 40px;
    }
    
    .horse-listing {
      background-color: var(--white);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 30px;
    }
    
    .horse-images {
      position: relative;
    }
    
    .main-image {
      width: 100%;
      height: 400px;
      object-fit: cover;
      cursor: pointer;
    }
    
    .thumbnail-gallery {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      padding: 10px;
      background-color: var(--light-bg);
    }
    
    .thumbnail {
      width: 100%;
      height: 80px;
      object-fit: cover;
      cursor: pointer;
      opacity: 0.7;
      transition: opacity 0.3s ease;
    }
    
    .thumbnail:hover,
    .thumbnail.active {
      opacity: 1;
    }
    
    .horse-details {
      padding: 30px;
    }
    
    .horse-details h2 {
      color: var(--primary-color);
      font-size: 2rem;
      margin-bottom: 20px;
    }
    
    .horse-specs {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      margin-bottom: 30px;
      padding: 20px;
      background-color: var(--light-bg);
      border-radius: 5px;
    }
    
    .spec-item {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .spec-item strong {
      color: var(--primary-color);
      min-width: 100px;
    }
    
    .horse-description {
      margin-bottom: 20px;
      line-height: 1.8;
    }
    
    .price-tag {
      font-size: 1.5rem;
      color: var(--primary-color);
      font-weight: bold;
      margin-bottom: 20px;
    }
    
    .contact-seller {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }
    
    .contact-seller a {
      padding: 12px 25px;
      background-color: var(--primary-color);
      color: white;
      text-decoration: none;
      border-radius: 5px;
      transition: background-color 0.3s ease;
    }
    
    .contact-seller a:hover {
      background-color: var(--secondary-color);
    }
    
    .sold-horses {
      margin-top: 60px;
      padding: 40px;
      background-color: var(--light-bg);
      border-radius: 10px;
    }
    
    .sold-horses h2 {
      color: var(--primary-color);
      margin-bottom: 30px;
      text-align: center;
    }
    
    .sold-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
    }
    
    .sold-horse {
      text-align: center;
    }
    
    .sold-horse img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      border-radius: 5px;
      filter: grayscale(50%);
    }
    
    .sold-horse p {
      margin-top: 10px;
      font-weight: 600;
    }
    
    .purchase-info {
      background-color: #e8f4f8;
      padding: 30px;
      border-radius: 10px;
      margin-top: 40px;
      border-left: 4px solid var(--primary-color);
    }
    
    .purchase-info h3 {
      color: var(--primary-color);
      margin-bottom: 15px;
    }
    
    .video-container {
      position: relative;
      padding-bottom: 56.25%;
      height: 0;
      overflow: hidden;
      margin-top: 20px;
    }
    
    .video-container iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
    
    .lightbox {
      display: none;
      position: fixed;
      z-index: 9999;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.9);
    }
    
    .lightbox-content {
      position: relative;
      max-width: 90%;
      max-height: 90%;
      margin: auto;
      top: 50%;
      transform: translateY(-50%);
      text-align: center;
    }
    
    .lightbox-content img {
      max-width: 100%;
      max-height: 90vh;
    }
    
    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 40px;
      color: white;
      font-size: 40px;
      cursor: pointer;
    }
    
    .lightbox-caption {
      color: white;
      margin-top: 20px;
      font-size: 1.1rem;
    }
    
    @media (max-width: 768px) {
      .page-header h1 {
        font-size: 2rem;
      }
      
      .horse-listing {
        grid-template-columns: 1fr;
      }
      
      .horse-specs {
        grid-template-columns: 1fr;
      }
      
      .sold-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>

  <main>
    <section class="page-header">
      <div class="container">
        <h1>Hästar till salu</h1>
        <p>Noga utvalda islandshästar med kvalitet och karaktär</p>
      </div>
    </section>

    <section class="container">
      <div class="horses-for-sale">
        <div class="horse-listing">
          <div class="horse-images">
            <img src="/images/IMG_3401.jpeg" alt="Embla från Stallviken" class="main-image lightbox-trigger" id="main-image-1" data-fullsize="/images/IMG_3401.jpeg">
            <div class="thumbnail-gallery">
              <img src="/images/IMG_3401.jpeg" alt="Embla bild 1" class="thumbnail active" onclick="changeMainImage(1, 1)">
              <img src="/images/IMG_3405.jpeg" alt="Embla bild 2" class="thumbnail" onclick="changeMainImage(1, 2)">
              <img src="/images/IMG_3407.jpeg" alt="Embla bild 3" class="thumbnail" onclick="changeMainImage(1, 3)">
            </div>
          </div>
          <div class="horse-details">
            <h2>Embla från Stallviken</h2>
            <div class="horse-specs">
              <div class="spec-item">
                <strong>Född:</strong>
                <span>2015</span>
              </div>
              <div class="spec-item">
                <strong>Kön:</strong>
                <span>Sto</span>
              </div>
              <div class="spec-item">
                <strong>Färg:</strong>
                <span>Brun</span>
              </div>
              <div class="spec-item">
                <strong>Mankhöjd:</strong>
                <span>138 cm</span>
              </div>
              <div class="spec-item">
                <strong>Gångarter:</strong>
                <span>Fyrgångare</span>
              </div>
              <div class="spec-item">
                <strong>Utbildning:</strong>
                <span>Säker ridhäst</span>
              </div>
            </div>
            <div class="horse-description">
              <p>Embla är ett underbart sto med fantastisk karaktär. Hon är trygg och pålitlig både i skogen och på banan. Med sin mjuka tölt och bekväma trav är hon en riktig drömhäst för den som vill ha en allround-partner.</p>
              <p>Embla har tävlat framgångsrikt i tölt T2 och passar utmärkt för ryttare som vill utvecklas inom gångartsridning. Hon är van vid barn och är alltid snäll och tålmodig.</p>
            </div>
            <div class="price-tag">
              Pris: 85 000 kr
            </div>
            <div class="contact-seller">
              <a href="/kontakt?subject=embla">Kontakta oss om Embla</a>
              <a href="tel:070-123-45-67">Ring: 070-123 45 67</a>
            </div>
          </div>
        </div>

        <div class="horse-listing">
          <div class="horse-images">
            <img src="/images/IMG_3408.jpeg" alt="Odin från Nordanvind" class="main-image lightbox-trigger" id="main-image-2" data-fullsize="/images/IMG_3408.jpeg">
            <div class="thumbnail-gallery">
              <img src="/images/IMG_3408.jpeg" alt="Odin bild 1" class="thumbnail active" onclick="changeMainImage(2, 1)">
              <img src="/images/IMG_3409.jpeg" alt="Odin bild 2" class="thumbnail" onclick="changeMainImage(2, 2)">
              <img src="/images/IMG_3410.jpeg" alt="Odin bild 3" class="thumbnail" onclick="changeMainImage(2, 3)">
            </div>
          </div>
          <div class="horse-details">
            <h2>Odin från Nordanvind</h2>
            <div class="horse-specs">
              <div class="spec-item">
                <strong>Född:</strong>
                <span>2012</span>
              </div>
              <div class="spec-item">
                <strong>Kön:</strong>
                <span>Valack</span>
              </div>
              <div class="spec-item">
                <strong>Färg:</strong>
                <span>Svart</span>
              </div>
              <div class="spec-item">
                <strong>Mankhöjd:</strong>
                <span>142 cm</span>
              </div>
              <div class="spec-item">
                <strong>Gångarter:</strong>
                <span>Femgångare</span>
              </div>
              <div class="spec-item">
                <strong>Utbildning:</strong>
                <span>Tävlingshäst</span>
              </div>
            </div>
            <div class="horse-description">
              <p>Odin är en kraftfull valack med imponerande gångarter. Hans pass är exceptionell och han har placerat sig på flera passlopp. Med sin starka vilja och atletiska förmåga är han perfekt för den ambitiösa ryttaren.</p>
              <p>Trots sin kraft är Odin lätt att hantera och mycket samarbetsvillig. Han är van vid transporter och olika tävlingsmiljöer.</p>
            </div>
            <div class="video-container">
              <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="Odin i träning" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
            <div class="price-tag">
              Pris: 120 000 kr
            </div>
            <div class="contact-seller">
              <a href="/kontakt?subject=odin">Kontakta oss om Odin</a>
              <a href="tel:070-123-45-67">Ring: 070-123 45 67</a>
            </div>
          </div>
        </div>

        <div class="horse-listing">
          <div class="horse-images">
            <img src="/images/IMG_3399.jpeg" alt="Astrid från Vikingagård" class="main-image lightbox-trigger" id="main-image-3" data-fullsize="/images/IMG_3399.jpeg">
            <div class="thumbnail-gallery">
              <img src="/images/IMG_3399.jpeg" alt="Astrid bild 1" class="thumbnail active" onclick="changeMainImage(3, 1)">
              <img src="/images/IMG_3400.jpeg" alt="Astrid bild 2" class="thumbnail" onclick="changeMainImage(3, 2)">
              <img src="/images/IMG_3407.jpeg" alt="Astrid bild 3" class="thumbnail" onclick="changeMainImage(3, 3)">
            </div>
          </div>
          <div class="horse-details">
            <h2>Astrid från Vikingagård</h2>
            <div class="horse-specs">
              <div class="spec-item">
                <strong>Född:</strong>
                <span>2018</span>
              </div>
              <div class="spec-item">
                <strong>Kön:</strong>
                <span>Sto</span>
              </div>
              <div class="spec-item">
                <strong>Färg:</strong>
                <span>Isabell</span>
              </div>
              <div class="spec-item">
                <strong>Mankhöjd:</strong>
                <span>136 cm</span>
              </div>
              <div class="spec-item">
                <strong>Gångarter:</strong>
                <span>Fyrgångare</span>
              </div>
              <div class="spec-item">
                <strong>Utbildning:</strong>
                <span>Grundutbildad</span>
              </div>
            </div>
            <div class="horse-description">
              <p>Astrid är ett ungt och lovande sto med fantastisk potential. Hon har nyligen påbörjat sin ridutbildning och visar redan prov på mjuka, bekväma gångarter och en vilja att samarbeta.</p>
              <p>Med sitt lugna temperament och sin nyfikenhet är Astrid perfekt för någon som vill fortsätta utbildningen tillsammans med en ung häst. Hon har goda anlag för tölt och kommer säkert att utvecklas till en fin ridhäst.</p>
            </div>
            <div class="price-tag">
              Pris: Kontakta oss för pris
            </div>
            <div class="contact-seller">
              <a href="/kontakt?subject=astrid">Kontakta oss om Astrid</a>
              <a href="tel:070-123-45-67">Ring: 070-123 45 67</a>
            </div>
          </div>
        </div>
      </div>

      <div class="purchase-info">
        <h3>Information om köp</h3>
        <ul>
          <li><strong>Provridning:</strong> Vi rekommenderar alltid provridning innan köp. Första provridningen kostar 500 kr, vilket dras av vid eventuellt köp.</li>
          <li><strong>Veterinärbesiktning:</strong> Vi välkomnar veterinärbesiktning på köparens bekostnad.</li>
          <li><strong>Transport:</strong> Vi kan hjälpa till att ordna transport till din hemort.</li>
          <li><strong>Försäkring:</strong> Vi rekommenderar att du tecknar försäkring direkt vid köp.</li>
          <li><strong>Uppföljning:</strong> Vi finns alltid tillgängliga för råd och stöd efter köpet.</li>
        </ul>
      </div>

      <div class="sold-horses">
        <h2>Tidigare sålda hästar - Referenser</h2>
        <div class="sold-grid">
          <div class="sold-horse">
            <img src="/images/IMG_3405.jpeg" alt="Freyr">
            <p>Freyr från Stallviken</p>
            <small>Såld 2023</small>
          </div>
          <div class="sold-horse">
            <img src="/images/IMG_3409.jpeg" alt="Sif">
            <p>Sif från Nordgården</p>
            <small>Såld 2023</small>
          </div>
          <div class="sold-horse">
            <img src="/images/IMG_3410.jpeg" alt="Balder">
            <p>Balder från Vikingstad</p>
            <small>Såld 2022</small>
          </div>
          <div class="sold-horse">
            <img src="/images/IMG_3401.jpeg" alt="Idun">
            <p>Idun från Stallviken</p>
            <small>Såld 2022</small>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    function changeMainImage(horseId, imageNum) {
      const mainImage = document.getElementById('main-image-' + horseId);
      const thumbnails = mainImage.parentElement.querySelectorAll('.thumbnail');
      
      // Update main image
      const horseImages = {
        1: ['/images/IMG_3401.jpeg', '/images/IMG_3405.jpeg', '/images/IMG_3407.jpeg'],
        2: ['/images/IMG_3408.jpeg', '/images/IMG_3409.jpeg', '/images/IMG_3410.jpeg'],
        3: ['/images/IMG_3399.jpeg', '/images/IMG_3400.jpeg', '/images/IMG_3407.jpeg']
      };
      mainImage.src = horseImages[horseId][imageNum-1];
      mainImage.dataset.fullsize = horseImages[horseId][imageNum-1];
      
      // Update active thumbnail
      thumbnails.forEach((thumb, index) => {
        if (index === imageNum - 1) {
          thumb.classList.add('active');
        } else {
          thumb.classList.remove('active');
        }
      });
    }
    
    // Initialize lightbox functionality
    document.addEventListener('DOMContentLoaded', function() {
      initLightbox();
    });
  </script>
</BaseLayout>