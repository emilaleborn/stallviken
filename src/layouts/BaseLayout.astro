---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  activeNav?: string;
}

const { title, description = "Stallvikens Islandshästar - Ridlektioner, hästträning och islandshästar till salu", activeNav } = Astro.props;
---

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title} - Stallvikens Islandshästar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Open+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>
    <a href="#main" class="skip-link">Hoppa till huvudinnehåll</a>
    <header>
        <div class="container">
            <div class="header-content">
                <h1 class="logo">Stallvikens Islandshästar</h1>
                <nav class="main-nav">
                    <button class="mobile-menu-toggle" aria-label="Toggle menu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <ul class="nav-list">
                        <li><a href="/" class={activeNav === 'home' ? 'active' : ''}>Hem</a></li>
                        <li><a href="/utbildning" class={activeNav === 'utbildning' ? 'active' : ''}>Utbildning & träning</a></li>
                        <li><a href="/om-oss" class={activeNav === 'om-oss' ? 'active' : ''}>Om oss</a></li>
                        <li><a href="/kontakt" class={activeNav === 'kontakt' ? 'active' : ''}>Kontakt</a></li>
                        <li><a href="/till-salu" class={activeNav === 'till-salu' ? 'active' : ''}>Våra hästar</a></li>
                        <li><a href="/galleri" class={activeNav === 'galleri' ? 'active' : ''}>Våran anläggning</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    <main id="main">
        <slot />
    </main>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>Kontakt</h3>
                    <p>Gunnarsbo 151</p>
                    <p>39595 Rockneby</p>
                    <p>Tel: 076-55050 46</p>
                    <p>E-post: stallvikensislandshastar@gmail.com</p>
                </div>
                <div class="footer-section">
                    <h3>Följ oss</h3>
                    <p>Instagram: @stallvikensislandshastar</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2024 Stallvikens Islandshästar. Alla rättigheter förbehållna.</p>
            </div>
        </div>
    </footer>
    
    <script>
      import '../scripts/main.js';
    </script>
</body>
</html>